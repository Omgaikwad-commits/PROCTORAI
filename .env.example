# ==========================================
# Exam Proctoring System - Environment Configuration
# ==========================================

# Flask Security
SECRET_KEY=replace-with-a-strong-random-secret-key
FLASK_DEBUG=False

# Server Port (PaaS platforms like Render/Railway set this automatically)
PORT=5000

# ==========================================
# Database Configuration (MySQL)
# ==========================================
# Option 1: Individual Connection Parameters (Local / VPS / RDS)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root123
DB_NAME=exam_proctoring
DB_PORT=3306

# Option 2: Full Connection URL (Popular on Railway, Render, etc.)
# If DATABASE_URL is set, it overrides the individual DB_* settings above.
# Example: mysql://user:password@host:port/database
# DATABASE_URL=mysql://root:root123@localhost:3306/exam_proctoring

# Optional: Enable SSL for Managed Cloud Databases (Aiven, PlanetScale, AWS RDS, etc.)
# Set to 'true' if your cloud database provider requires SSL
DB_SSL=false
